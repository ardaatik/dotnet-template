{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"Cors": {
		"AllowedOrigins": ["https://your-app.example.com"]
	},
	"Jwt": {
		"Key": "CHANGE-ME-use-environment-variable",
		"Issuer": "dotnet-template.api",
		"Audience": "dotnet-template.app",
		"ExpirationInMinutes": 60,
		"RefreshTokenExpirationDays": 7
	}
}
