<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e7bcdd92-9335-4762-8c4a-f354fd509ee0</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <SpaRoot>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), '..', '..', 'client', 'ui'))</SpaRoot>
    <SpaDistOutput>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), 'wwwroot'))</SpaDistOutput>
    <SkipClientBuild Condition="'$(SkipClientBuild)' == ''">true</SkipClientBuild>
    <DbProvider Condition="'$(DbProvider)' == ''">SqlServer</DbProvider>
    <AuthProvider Condition="'$(AuthProvider)' == ''">Identity</AuthProvider>
  </PropertyGroup>

  <Target Name="PublishSpaApp" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Message Importance="high" Text="Building client SPA from $(SpaRoot)" />
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" EnvironmentVariables="VITE_API_BASE_URL=" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)/dist/**" />
    </ItemGroup>
    <Error Condition="'@(SpaDistFiles)' == ''" Text="SPA build produced no files in $(SpaRoot)/dist. Check npm run build output." />
    <RemoveDir Directories="$(SpaDistOutput)" Condition="Exists('$(SpaDistOutput)')" />
    <MakeDir Directories="$(SpaDistOutput)" />
    <Copy SourceFiles="@(SpaDistFiles)" DestinationFiles="@(SpaDistFiles->'$(SpaDistOutput)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(SpaDistOutput)/index.html')" Text="SPA build did not produce wwwroot/index.html." />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(SpaDistFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="Variants/**" />
    <Compile Remove="Migrations/**" />
    <Compile Remove="Infra/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'SqlServer'">
    <Compile Include="Variants/Database/SqlServer/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(DbProvider)' == 'Postgres'">
    <Compile Include="Variants/Database/Postgres/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(AuthProvider)' == 'Identity'">
    <Compile Include="Variants/Auth/Identity/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(AuthProvider)' == 'Entra'">
    <Compile Include="Variants/Auth/Entra/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(AuthProvider)' == 'Identity' and '$(DbProvider)' == 'SqlServer'">
    <Compile Include="Migrations/SqlServer/Application/**/*.cs" />
    <Compile Include="Migrations/SqlServer/Identity/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(AuthProvider)' == 'Identity' and '$(DbProvider)' == 'Postgres'">
    <Compile Include="Migrations/Postgres/Application/**/*.cs" />
    <Compile Include="Migrations/Postgres/Identity/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(AuthProvider)' == 'Entra' and '$(DbProvider)' == 'SqlServer'">
    <Compile Include="Migrations/SqlServer/ApplicationEntra/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(AuthProvider)' == 'Entra' and '$(DbProvider)' == 'Postgres'">
    <Compile Include="Migrations/Postgres/ApplicationEntra/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.JsonPatch" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'SqlServer'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
  <ItemGroup Condition="'$(DbProvider)' == 'Postgres'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <Using Include="Npgsql.EntityFrameworkCore.PostgreSQL.Metadata" />
  </ItemGroup>

  <ItemGroup Condition="'$(AuthProvider)' == 'Identity'">
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup Condition="'$(AuthProvider)' == 'Entra'">
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Microsoft.Identity.Web.GraphServiceClient" />
  </ItemGroup>

</Project>
